function parseArgs(argv) {
  var out = { _: [] };
  for (var i = 0; i < argv.length; i++) {
    var arg = argv[i];
    if (arg.indexOf('--') === 0) {
      var kv = splitOnce(arg.slice(2), '=');
      var key = kv[0];
      var value = kv[1];
      if (value === undefined || value === '') {
        if (i + 1 < argv.length && argv[i + 1].indexOf('-') !== 0) {
          value = argv[++i];
        } else {
          value = true;
        }
      }
      if (key === 'extension' || key === 'ext') {
        out[key] = out[key] || [];
        out[key].push(value);
      } else {
        out[key] = value;
      }
    } else if (arg.indexOf('-') === 0) {
      out[arg.slice(1)] = true;
    } else {
      out._.push(arg);
    }
  }
  return out;
}

function tokenizeCommandLine(line) {
  var input = String(line || '').trim();
  if (!input) return [];
  var tokens = [];
  var re = /"([^"]*)"|'([^']*)'|([^\s]+)/g;
  var match;
  while ((match = re.exec(input)) !== null) {
    tokens.push(match[1] !== undefined ? match[1] : (match[2] !== undefined ? match[2] : match[3]));
  }
  return tokens;
}

function splitOnce(value, delimiter) {
  var idx = value.indexOf(delimiter);
  if (idx === -1) return [value, undefined];
  return [value.slice(0, idx), value.slice(idx + delimiter.length)];
}

function shortId() {
  return crypto.randomBytes(4).toString('hex');
}

function slugify(value) {
  return String(value || '')
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '') || 'poiva';
}

function humanize(value) {
  return String(value || '')
    .replace(/[-_]+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .replace(/(^|\s)\w/g, function (m) { return m.toUpperCase(); });
}

function padRight(value, width) {
  value = String(value);
  while (value.length < width) value += ' ';
  return value;
}

function printTable(headers, rows) {
  var c = COLORS;
  var widths = headers.map(function (header) { return String(header).length; });
  rows.forEach(function (row) {
    row.forEach(function (cell, i) {
      widths[i] = Math.max(widths[i], String(cell).length);
    });
  });
  
  function colorizeCell(value, colIndex, headerName) {
    var str = String(value);
    if (!str) return str;
    
    // Color status/role columns
    if (headerName.toLowerCase().includes('status') || headerName.toLowerCase().includes('role') || headerName.toLowerCase().includes('decision')) {
      if (str === 'draft' || str === 'pending') return c.yellow + str + c.reset;
      if (str === 'active' || str === 'executing' || str === 'active' || str === 'approved') return c.green + str + c.reset;
      if (str === 'completed' || str === 'done' || str === 'archived') return c.blue + str + c.reset;
      if (str === 'failed' || str === 'rejected' || str === 'cancelled') return c.red + str + c.reset;
    }
    
    // Color ID columns (dimmed)
    if (headerName.toLowerCase() === 'id') return c.dim + str + c.reset;
    
    return str;
  }
  
  function fmt(row, isHeader) {
    return row.map(function (cell, i) {
      var padded = padRight(String(cell), widths[i]);
      if (isHeader) {
        return c.bold + c.cyan + padded + c.reset;
      }
      return colorizeCell(padded, i, headers[i]);
    }).join(c.dim + '  │  ' + c.reset);
  }
  
  // Header
  console.log('');
  console.log(c.dim + '┌' + widths.map(function(w) { return new Array(w + 1).join('─'); }).join('─┬─') + '┐' + c.reset);
  console.log(c.dim + '│ ' + c.reset + fmt(headers, true) + c.dim + ' │' + c.reset);
  console.log(c.dim + '├' + widths.map(function(w) { return new Array(w + 1).join('─'); }).join('─┼─') + '┤' + c.reset);
  
  // Rows
  rows.forEach(function (row) {
    console.log(c.dim + '│ ' + c.reset + fmt(row, false) + c.dim + ' │' + c.reset);
  });
  
  console.log(c.dim + '└' + widths.map(function(w) { return new Array(w + 1).join('─'); }).join('─┴─') + '┘' + c.reset);
  console.log('');
}

function info(message) {
  console.log(COLORS.green + '✓' + COLORS.reset + ' ' + message);
}

function error(message) {
  console.error(COLORS.red + '✗ Error:' + COLORS.reset + ' ' + message);
}

