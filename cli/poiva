function requestCloud(session, method, apiPath, body) {
  if (!session || !session.url || !session.token) {
    return Promise.reject(new Error('No active session credentials'));
  }
  var base = normalizeBaseUrl(session.url);
  var target = new URL(base + apiPath);
  var isHttps = target.protocol === 'https:';
  var transport = isHttps ? https : http;
  var payload = body ? JSON.stringify(body) : null;
  var token = String(session.token || '').trim();
  var headers = { 'Accept': 'application/json' };
  if (/^pk_live_/i.test(token)) {
    headers['X-API-Key'] = token;
    headers['X-Poiva-Api-Key'] = token;
  } else if (/^Bearer\s+/i.test(token)) {
    headers['Authorization'] = token;
  } else {
    headers['Authorization'] = 'Bearer ' + token;
  }
  if (payload) {
    headers['Content-Type'] = 'application/json';
    headers['Content-Length'] = Buffer.byteLength(payload);
  }

  return new Promise(function (resolve, reject) {
    var req = transport.request({
      protocol: target.protocol,
      hostname: target.hostname,
      port: target.port || (isHttps ? 443 : 80),
      path: target.pathname + target.search,
      method: method,
      headers: headers,
      timeout: 15000
    }, function (res) {
      var chunks = [];
      res.on('data', function (chunk) { chunks.push(chunk); });
      res.on('end', function () {
        var text = Buffer.concat(chunks).toString('utf8');
        if (res.statusCode < 200 || res.statusCode >= 300) {
          var message = text || ('HTTP ' + res.statusCode);
          try {
            var parsedError = text ? JSON.parse(text) : null;
            if (parsedError && parsedError.message) message = parsedError.message;
            if (parsedError && parsedError.error && !parsedError.message) message = parsedError.error;
          } catch (_) {}
          reject(new Error(message));
          return;
        }
        if (!text) {
          resolve(null);
          return;
        }
        try {
          resolve(JSON.parse(text));
        } catch (_) {
          resolve(text);
        }
      });
    });
    req.on('timeout', function () {
      req.destroy(new Error('Request timed out'));
    });
    req.on('error', function (err) { reject(err); });
    if (payload) req.write(payload);
    req.end();
  });
}

function readStructuredFile(file) {
