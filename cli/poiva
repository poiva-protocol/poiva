function maybeHandleRemoteResource(resource, verb, argv) {
  var session = getCurrentSession();
  if (!session) return null;
  if (!RESOURCE_DEFS[resource]) return null;

  var def = REMOTE_RESOURCE_DEFS[resource];
  if (!def) {
    error("'" + resource + "' has no remote API yet. Use a local .poiva workspace (no active session) to manage this resource type.");
    process.exitCode = 1;
    return Promise.resolve();
  }

  var mutatingVerbs = ['create', 'add', 'upload', 'submit', 'update', 'approve', 'reject', 'archive', 'cancel', 'start', 'complete', 'verify', 'run'];
  var shouldCatch = mutatingVerbs.indexOf(verb) !== -1 || verb === 'export';

  var run = remoteResourceOperation(session, resource, def, verb, argv);
  if (run === null) return null;
  if (!shouldCatch) return run;

  return run.catch(function (err) {
    error(resource + ' ' + verb + ' failed: ' + err.message);
    process.exitCode = 1;
  });
}

function remoteResourceOperation(session, resource, def, verb, argv) {
  if (verb === 'create' || verb === 'add' || verb === 'upload' || verb === 'submit') {
    return remoteCreate(session, resource, def, argv);
  }

  if (verb === 'list' || verb === 'watch' || verb === 'tail' || verb === 'history' || verb === 'timeline') {
    return remoteList(session, resource, def, argv, verb);
  }

  if (verb === 'export') {
    return remoteExport(session, resource, def, argv);
  }

  var stateVerbs = ['update', 'approve', 'reject', 'archive', 'cancel', 'start', 'complete', 'verify', 'run'];
  if (stateVerbs.indexOf(verb) !== -1) {
    return remoteUpdateState(session, resource, def, verb, argv);
  }

  if (verb === 'delete' || verb === 'remove' || verb === 'get' || verb === 'download' || verb === 'graph' || verb === 'assign' || verb === 'import' || verb === 'search') {
    error(resource + ' ' + verb + ' is not available through the remote API — only create, list, and state updates are.');
    process.exitCode = 1;
    return Promise.resolve();
  }

  return null;
}

function splitParent(def, argv) {
  if (!def.parentParam) {
    return { parentId: null, rest: argv };
  }
  return { parentId: argv[0], rest: argv.slice(1) };
}

function remoteCreate(session, resource, def, argv) {
  var split = splitParent(def, argv);
  if (def.parentParam && !split.parentId) {
    error(resource + ' create <' + def.parentParam + '> [--flags]');
    process.exitCode = 1;
    return Promise.resolve();
  }
  var args = parseArgs(split.rest);
  var input = args.file ? readStructuredFile(args.file) : {};

  var gather;
  if (process.stdin.isTTY && !args.file && Object.keys(args).length <= 1) {
    var prompt = createPrompt();
    var p = Promise.resolve();
    def.createFields.forEach(function (field) {
      p = p.then(function () { return prompt.ask(field, input[field] || ''); })
        .then(function (value) { if (value) input[field] = value; });
    });
    gather = p.then(function () { prompt.close(); return input; }).catch(function (err) { prompt.close(); throw err; });
  } else {
    gather = Promise.resolve(input);
  }

  return gather.then(function (payload) {
    mergeFlagFields(payload, args);
    if (payload.amount !== undefined && payload.amount !== '') payload.amount = Number(payload.amount);
    return requestCloud(session, 'POST', def.createPath(split.parentId), payload);
  }).then(function (created) {
    console.log(stringifyRecord(def.toRow(created)));
  });
}

function remoteUpdateState(session, resource, def, verb, argv) {
  if (!def.statePath) {
    error(resource + ' has no state-update endpoint remotely.');
    process.exitCode = 1;
    return Promise.resolve();
  }
  var id = argv[0];
  if (!id) {
    error(resource + ' ' + verb + ' <id> [--' + def.stateField + ' VALUE]');
    process.exitCode = 1;
    return Promise.resolve();
  }
  var args = parseArgs(argv.slice(1));
  var value = args[def.stateField];
  if (!value && verb !== 'update') {
    value = statusForVerb(verb);
  }
  if (!value) {
    error(resource + ' ' + verb + ' <id> --' + def.stateField + ' <' + def.stateValues.join('|') + '>');
    process.exitCode = 1;
    return Promise.resolve();
  }
  value = String(value).toUpperCase();
  if (def.stateValues.indexOf(value) === -1) {
    error('Invalid ' + def.stateField + ' for ' + resource + ': ' + value + ' (expected one of ' + def.stateValues.join(', ') + ')');
    process.exitCode = 1;
    return Promise.resolve();
  }
  var body = {};
  body[def.stateField] = value;
  return requestCloud(session, 'PATCH', def.statePath(id), body).then(function (updated) {
    console.log(stringifyRecord(def.toRow(updated)));
  });
}

function remoteList(session, resource, def, argv, verb) {
  var split = splitParent(def, argv);
  if (def.parentParam && !split.parentId) {
    error(resource + ' ' + verb + ' <' + def.parentParam + '>');
    process.exitCode = 1;
    return Promise.resolve();
  }
  var args = parseArgs(split.rest);
  return requestCloud(session, 'GET', def.listPath(split.parentId)).then(function (items) {
    var rows = (items || []).map(def.toRow);
    if (args.status) {
      var wanted = String(args.status).toUpperCase();
      rows = rows.filter(function (row) { return String(row.status || '').toUpperCase() === wanted; });
    }
    if (args.search) {
      var term = String(args.search).toLowerCase();
      rows = rows.filter(function (row) { return JSON.stringify(row).toLowerCase().indexOf(term) !== -1; });
    }
    if (rows.length === 0) {
      info('No entries.');
      return;
    }
    if (verb === 'watch' || verb === 'tail' || verb === 'history' || verb === 'timeline') {
      rows.forEach(function (row) { console.log(formatWatchLine(row)); });
      return;
    }
    printTable(def.columns, rows.map(function (row) {
      return def.columns.map(function (col) { return displayCell(row[col]); });
    }));
    console.log('');
    console.log(rows.length + ' total');
  });
}

function remoteExport(session, resource, def, argv) {
  var split = splitParent(def, argv);
  if (def.parentParam && !split.parentId) {
    error(resource + ' export <' + def.parentParam + '> [--output file]');
    process.exitCode = 1;
    return Promise.resolve();
  }
  var args = parseArgs(split.rest);
  return requestCloud(session, 'GET', def.listPath(split.parentId)).then(function (items) {
    writeExportPayload(resource, (items || []).map(def.toRow), args);
  });
}

