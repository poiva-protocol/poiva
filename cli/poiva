  var output = JSON.stringify(record, null, 2);
  if (args.output) {
    fs.writeFileSync(path.resolve(args.output), output + '\n', 'utf8');
    info('Downloaded ' + resource + ' to ' + args.output);
    return;
  }
  console.log(output);
}

function resourceSearch(resource, argv) {
  var term = argv.join(' ');
  if (!term) {
    error(resource + ' search <term>');
    process.exitCode = 1;
    return;
  }
  var workspace = requireWorkspace();
  var records = loadResourceStore(workspace.root, resource);
  var results = records.filter(function (record) { return recordMatches(record, term); });
  if (results.length === 0) {
    info('No matches.');
    return;
  }
  printTable(['id', 'title', 'status'], results.map(function (item) {
    return [item.id, displayCell(item[RESOURCE_DEFS[resource].titleField] || item.title), displayCell(item[RESOURCE_DEFS[resource].statusField] || item.status)];
  }));
}

