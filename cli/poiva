function createPrompt() {
  var rl = readline.createInterface({ input: process.stdin, output: process.stdout });
  return {
    ask: function (label, defaultValue) {
      return new Promise(function (resolve) {
        var suffix = defaultValue ? ' [' + defaultValue + ']' : '';
        rl.question(label + suffix + ': ', function (answer) {
          resolve((answer || '').trim() || defaultValue || '');
        });
      });
    },
    close: function () { rl.close(); }
  };
}

function promptResource(def, seed) {
  var prompt = createPrompt();
  var input = seed || {};
  var fields = def.promptFields.slice();
  var p = Promise.resolve();
  fields.forEach(function (field) {
    p = p.then(function () { return prompt.ask(field, input[field] || ''); }).then(function (value) { input[field] = value; });
  });
  return p.then(function () {
    prompt.close();
    return input;
  }).catch(function (err) {
    prompt.close();
    throw err;
  });
}

function mergeFlagFields(input, args) {
  Object.keys(args).forEach(function (key) {
    if (key === '_' || key === 'file' || key === 'extension' || key === 'ext' || key === 'interactive' || key === 'force' || key === 'output' || key === 'name' || key === 'url' || key === 'token' || key === 'page' || key === 'size' || key === 'status' || key === 'search' || key === 'limit') return;
    input[key] = args[key];
  });
  if (args.extension || args.ext) {
    input.extensions = input.extensions || [];
    [].concat(args.extension || [], args.ext || []).forEach(function (pair) {
      var split = splitOnce(pair, '=');
      if (!split[0]) return;
      input.extensions.push({ name: split[0], value: split[1] || '' });
    });
  }
}

function normalizeRecord(resource, input, workspace) {
  var now = new Date().toISOString();
  var record = clone(input || {});
  record.id = record.id || generateRecordId(resource, record);
  record.status = record.status || record.decision || record.state || RESOURCE_DEFS[resource].defaultStatus || 'draft';
  record.extensions = Array.isArray(record.extensions) ? record.extensions : [];
  record.organizationId = record.organizationId || (workspace && workspace.currentOrganizationId) || '';
  record.createdAt = record.createdAt || now;
  record.updatedAt = now;
  return record;
}

function generateRecordId(resource, record) {
  var seed = record.code || record.slug || record.title || record.display || record.name || shortId();
  return resource + '-' + slugify(seed).replace(/^-+|-+$/g, '') + '-' + shortId();
}

function filterRecords(records, args) {
  var search = (args.search || args._.join(' ') || '').trim().toLowerCase();
  var status = (args.status || '').trim().toLowerCase();
  var owner = (args.owner || '').trim().toLowerCase();
  var filtered = records.filter(function (record) {
    if (status && String(record.status || record.decision || '').toLowerCase() !== status) return false;
    if (owner) {
      var ownerValue = String(record.owner || record.createdBy || record.assignee || record.submittedBy || '').toLowerCase();
      if (ownerValue.indexOf(owner) === -1) return false;
    }
    if (search && !recordMatches(record, search)) return false;
    return true;
  });
  return filtered;
}

function recordMatches(record, term) {
  var hay = JSON.stringify(record).toLowerCase();
  return hay.indexOf(term.toLowerCase()) !== -1;
}

function searchWorkspace(workspace, term) {
