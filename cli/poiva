function main() {
  var argv = process.argv.slice(2);
  if (argv.length === 0 || argv[0] === '--help' || argv[0] === '-h' || argv[0] === 'help') {
    printHelp();
    return;
  }

  var command = argv[0];
  var rest = argv.slice(1);

  if (command === 'auth') return handleAuth(rest);
  if (command === 'session') return handleSession(rest);
  if (command === 'org') return handleOrg(rest);
  if (command === 'search') return handleSearch(rest);
  if (command === 'profile') return handleProfile(rest);
  if (command === 'config') return handleConfig(rest);
  if (command === 'extension') return handleExtension(rest);
  if (command === 'version') return handleVersion(rest);
  if (command === 'completion') return handleCompletion(rest);
  if (command === 'doctor') return handleDoctor(rest);
  if (command === 'dashboard') return handleDashboard(rest);
  if (command === 'init') return handleInit(rest);

  if (RESOURCE_DEFS[command]) return handleResource(command, rest);

  error('Unknown command: ' + command);
  printHelp();
  process.exitCode = 1;
}

function handleAuth(argv) {
  var sub = argv[0];
  if (!sub || sub === 'help') {
    printSection('auth', ['login', 'logout', 'whoami']);
    return;
  }
  if (sub === 'login') return authLogin(argv.slice(1));
  if (sub === 'logout') return authLogout();
  if (sub === 'whoami') return authWhoami();
  error('Unknown auth command: ' + sub);
  process.exitCode = 1;
}

function handleSession(argv) {
  var sub = argv[0];
  if (!sub || sub === 'help') {
    printSection('session', ['list', 'add', 'remove', 'rename', 'use', 'current', 'export', 'import']);
    return;
  }
  if (sub === 'list') return sessionList();
  if (sub === 'add') return sessionAdd(argv.slice(1));
  if (sub === 'remove') return sessionRemove(argv.slice(1));
  if (sub === 'rename') return sessionRename(argv.slice(1));
  if (sub === 'use') return sessionUse(argv.slice(1));
  if (sub === 'current') return sessionCurrent();
