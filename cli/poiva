  function dumpYaml(obj, indent) {
    indent = indent || 0;
    var pad = new Array(indent + 1).join(' ');
    var lines = [];
    Object.keys(obj || {}).forEach(function (key) {
      var value = obj[key];
      if (value === null || value === undefined) {
        lines.push(pad + key + ':');
      } else if (Array.isArray(value)) {
        if (value.length === 0) {
          lines.push(pad + key + ': []');
        } else {
          lines.push(pad + key + ':');
          value.forEach(function (item) {
            if (item && typeof item === 'object' && !Array.isArray(item)) {
              lines.push(pad + '  -');
              lines.push(dumpYaml(item, indent + 4));
            } else {
              lines.push(pad + '  - ' + yamlScalar(item));
            }
          });
        }
      } else if (typeof value === 'object') {
        lines.push(pad + key + ':');
        lines.push(dumpYaml(value, indent + 2));
      } else {
        lines.push(pad + key + ': ' + yamlScalar(value));
      }
    });
    return lines.join('\n');
  }

  function parseYaml(text) {
    var lines = String(text || '').split(/\r?\n/);
    var out = {};
    var currentKey = null;
    var currentArray = null;
    for (var i = 0; i < lines.length; i++) {
      var raw = lines[i];
      if (!raw || /^\s*#/.test(raw)) continue;
      if (/^\s*$/.test(raw)) continue;
      var arrayMatch = raw.match(/^\s*-\s+(.*)$/);
      if (arrayMatch && currentArray) {
        currentArray.push(parseScalarValue(arrayMatch[1]));
        continue;
      }
      var kv = raw.match(/^([^:]+):\s*(.*)$/);
      if (!kv) continue;
      currentKey = kv[1].trim();
      var value = kv[2].trim();
      currentArray = null;
      if (value === '[]') {
        out[currentKey] = [];
        continue;
      }
      if (value === '') {
        out[currentKey] = '';
        currentArray = Array.isArray(out[currentKey]) ? out[currentKey] : null;
        continue;
      }
      out[currentKey] = parseScalarValue(value);
      if (Array.isArray(out[currentKey])) currentArray = out[currentKey];
    }
    return out;
  }

  function parseScalarValue(value) {
    var trimmed = String(value || '').trim();
    if (trimmed === 'true') return true;
    if (trimmed === 'false') return false;
    if (trimmed === 'null' || trimmed === '~') return null;
    if (/^-?\d+$/.test(trimmed)) return parseInt(trimmed, 10);
    if (/^-?\d+\.\d+$/.test(trimmed)) return parseFloat(trimmed);
    if ((trimmed[0] === '"' && trimmed[trimmed.length - 1] === '"') || (trimmed[0] === '\'' && trimmed[trimmed.length - 1] === '\'')) {
      return trimmed.slice(1, -1);
    }
    if (trimmed[0] === '[' && trimmed[trimmed.length - 1] === ']') {
      var inner = trimmed.slice(1, -1).trim();
      if (!inner) return [];
      return inner.split(',').map(function (part) { return parseScalarValue(part.trim()); });
    }
    return trimmed;
  }

  function yamlScalar(value) {
    if (value === null || value === undefined) return "''";
    if (typeof value === 'number' || typeof value === 'boolean') return String(value);
    var stringValue = String(value);
    if (stringValue === '') return "''";
    if (/^[A-Za-z0-9._:-]+$/.test(stringValue)) return stringValue;
    return JSON.stringify(stringValue);
  }

  function clone(value) {
    return JSON.parse(JSON.stringify(value || {}));
  }

