function startDashboard(args) {
  var state = {
    session: getCurrentSession(),
    workspace: null,
    resource: (args.resource && RESOURCE_DEFS[args.resource]) ? args.resource : 'mission',
    page: parseInt(args.page || '1', 10),
    size: parseInt(args.size || '20', 10),
    status: String(args.status || '').trim(),
    search: String(args.search || '').trim(),
    watch: String(args.watch || 'on').toLowerCase() !== 'off',
    intervalSeconds: parseInt(args.interval || '5', 10),
    running: true,
    busy: false
  };
  if (isNaN(state.page) || state.page < 1) state.page = 1;
  if (isNaN(state.size) || state.size < 1) state.size = 20;
  if (isNaN(state.intervalSeconds) || state.intervalSeconds < 1) state.intervalSeconds = 5;

  if (!state.session) {
    state.workspace = getWorkspaceIfAny();
  }
  if (!state.session && !state.workspace) {
    error('Dashboard needs an active session or a local .poiva workspace.');
    process.exitCode = 1;
    return;
  }

  var rl = readline.createInterface({ input: process.stdin, output: process.stdout, terminal: true });
  var timer = null;
  var promptLabel = function () { return 'poiva[' + state.resource + '] > '; };
  rl.setPrompt(promptLabel());

  function askInline(question, defaultValue) {
    return new Promise(function (resolve) {
      var suffix = defaultValue ? ' [' + defaultValue + ']' : '';
      rl.question(question + suffix + ': ', function (answer) {
        var out = (answer || '').trim();
        resolve(out || defaultValue || '');
      });
    });
  }

  function remoteDashboardDef() {
    var def = REMOTE_RESOURCE_DEFS[state.resource];
    if (!def) {
      throw new Error("'" + state.resource + "' has no remote API yet — switch to a local .poiva workspace for this resource type.");
    }
    if (def.parentParam) {
      throw new Error("'" + state.resource + "' needs a " + def.parentParam + " — live dashboard browsing only supports 'mission' remotely. Use the regular CLI (e.g. `poiva " + state.resource + " list <" + def.parentParam + ">`) instead.");
    }
    return def;
  }

  function fetchSnapshot() {
    if (state.session) {
      return Promise.resolve().then(function () {
        return remoteDashboardDef();
      }).then(function (def) {
        return requestCloud(state.session, 'GET', def.listPath()).then(function (result) {
          return { result: result, def: def };
        });
      }).then(function (wrapped) {
        var result = wrapped.result;
        var def = wrapped.def;
        var rows = (result || []).map(def.toRow);
        if (state.status) {
          var wanted = state.status.toUpperCase();
          rows = rows.filter(function (row) { return String(row.status || '').toUpperCase() === wanted; });
        }
        if (state.search) {
          var term = state.search.toLowerCase();
          rows = rows.filter(function (row) { return JSON.stringify(row).toLowerCase().indexOf(term) !== -1; });
        }
        var start = (state.page - 1) * state.size;
        return {
          items: rows.slice(start, start + state.size),
          page: state.page,
          size: state.size,
          totalElements: rows.length,
          totalPages: Math.max(1, Math.ceil(rows.length / state.size))
        };
      });
    }

    var records = loadResourceStore(state.workspace.root, state.resource);
    if (state.status) {
      var wanted = state.status.toLowerCase();
      records = records.filter(function (record) {
        return String(record.status || record.decision || '').toLowerCase() === wanted;
      });
    }
    if (state.search) {
      records = records.filter(function (record) { return recordMatches(record, state.search); });
    }
    records.sort(sortByDateDesc);
    var start = (state.page - 1) * state.size;
    var pageItems = records.slice(start, start + state.size);
    return Promise.resolve({
      items: pageItems,
      page: state.page,
      size: state.size,
      totalElements: records.length,
      totalPages: Math.ceil(records.length / state.size)
    });
  }

  function render(snapshot) {
    process.stdout.write('\x1Bc');
    console.log(COLORS.bold + COLORS.cyan + 'Poiva Live Dashboard' + COLORS.reset + '  ' + COLORS.dim + (state.session ? state.session.name : 'local-workspace') + COLORS.reset);
    console.log(COLORS.dim + 'resource=' + state.resource + ' page=' + snapshot.page + ' size=' + snapshot.size + ' watch=' + (state.watch ? 'on' : 'off') + ' interval=' + state.intervalSeconds + 's' + COLORS.reset);
    if (state.status || state.search) {
      console.log(COLORS.dim + 'filters: status=' + (state.status || '—') + ', search=' + (state.search || '—') + COLORS.reset);
    }
    console.log(COLORS.dim + 'Commands: help, resource <name>, create, update <id>, delete <id>, open <id>, search <term|clear>, status <value|clear>, next, prev, watch on|off, interval <sec>, refresh, quit' + COLORS.reset);
    var rows = snapshot.items || [];
    var columns = (state.session ? REMOTE_RESOURCE_DEFS[state.resource] : RESOURCE_DEFS[state.resource]).columns;
    if (rows.length === 0) {
      console.log('');
      info('No entries.');
    } else {
      printTable(columns, rows.map(function (item) {
        return columns.map(function (col) { return displayCell(item[col]); });
      }));
    }
    console.log(COLORS.dim + 'Total: ' + snapshot.totalElements + ' | Pages: ' + Math.max(1, snapshot.totalPages || 0) + COLORS.reset);
  }

  function refresh() {
    if (!state.running || state.busy) return Promise.resolve();
    state.busy = true;
    return fetchSnapshot()
      .then(function (snapshot) { render(snapshot); })
      .catch(function (err) { error('dashboard refresh failed: ' + err.message); })
      .finally(function () {
        state.busy = false;
        if (state.running) {
          rl.setPrompt(promptLabel());
          rl.prompt();
        }
      });
  }

  function stopDashboard() {
    state.running = false;
    if (timer) clearInterval(timer);
    rl.close();
  }

  function setWatch(enabled) {
    state.watch = enabled;
    if (timer) clearInterval(timer);
    timer = null;
    if (state.watch) {
      timer = setInterval(function () {
        refresh();
      }, state.intervalSeconds * 1000);
    }
  }

  function createRecordFromDashboard(tokens) {
    if (state.session) {
      return Promise.resolve().then(function () {
        var def = remoteDashboardDef();
        var args = parseArgs(tokens.slice(1));
        var input = args.file ? readStructuredFile(args.file) : {};
        mergeFlagFields(input, args);
        var shouldPrompt = !args.file && Object.keys(args).length <= 1;
        var p = Promise.resolve(input);
        if (shouldPrompt) {
          def.createFields.forEach(function (field) {
            p = p.then(function (current) {
              return askInline(field, current[field] || '').then(function (value) {
                if (value) current[field] = value;
                return current;
              });
            });
          });
        }
        return p.then(function (payload) {
          return requestCloud(state.session, 'POST', def.createPath(null), payload);
        }).then(function (created) {
          info('Created ' + state.resource + ': ' + def.toRow(created).id);
        });
      });
    }

    var def = RESOURCE_DEFS[state.resource];
    var args = parseArgs(tokens.slice(1));
    var input = args.file ? readStructuredFile(args.file) : {};
    mergeFlagFields(input, args);
    var shouldPrompt = !args.file && Object.keys(args).length <= 1;

    var p = Promise.resolve(input);
    if (shouldPrompt) {
      def.promptFields.forEach(function (field) {
        p = p.then(function (current) {
          return askInline(field, current[field] || '').then(function (value) {
            current[field] = value;
            return current;
          });
        });
      });
    }
    return p.then(function (payload) {
      var record = normalizeRecord(state.resource, payload, state.workspace);
      var records = loadResourceStore(state.workspace.root, state.resource);
      records.push(record);
      saveResourceStore(state.workspace.root, state.resource, records);
      info('Created ' + state.resource + ': ' + record.id);
    });
  }

  function updateRecordFromDashboard(tokens) {
    var id = tokens[1];
    if (!id) throw new Error('update <id> --' + (REMOTE_RESOURCE_DEFS[state.resource] ? REMOTE_RESOURCE_DEFS[state.resource].stateField : 'field') + ' value');
    var args = parseArgs(tokens.slice(2));
    if (state.session) {
      return Promise.resolve().then(function () {
        var def = remoteDashboardDef();
        if (!def.statePath) throw new Error(state.resource + ' has no state-update endpoint remotely.');
        var value = args[def.stateField];
        if (!value) throw new Error('update <id> --' + def.stateField + ' <' + def.stateValues.join('|') + '>');
        value = String(value).toUpperCase();
        if (def.stateValues.indexOf(value) === -1) {
          throw new Error('Invalid ' + def.stateField + ': ' + value + ' (expected one of ' + def.stateValues.join(', ') + ')');
        }
        var body = {};
        body[def.stateField] = value;
        return requestCloud(state.session, 'PATCH', def.statePath(id), body);
      }).then(function () { info('Updated ' + state.resource + ': ' + id); });
    }
    var patch = args.file ? readStructuredFile(args.file) : {};
    mergeFlagFields(patch, args);
    var records = loadResourceStore(state.workspace.root, state.resource);
    var record = records.find(function (item) { return item.id === id; });
    if (!record) throw new Error(state.resource + ' not found: ' + id);
    Object.keys(patch).forEach(function (key) {
      if (key !== 'id' && key !== 'createdAt') record[key] = patch[key];
    });
    record.updatedAt = new Date().toISOString();
    saveResourceStore(state.workspace.root, state.resource, records);
    info('Updated ' + state.resource + ': ' + id);
    return Promise.resolve();
  }

  function deleteRecordFromDashboard(tokens) {
    var id = tokens[1];
    if (!id) throw new Error('delete <id>');
    if (state.session) {
      throw new Error(state.resource + ' delete is not available through the remote API.');
    }
    var records = loadResourceStore(state.workspace.root, state.resource);
    var next = records.filter(function (item) { return item.id !== id; });
    if (next.length === records.length) throw new Error(state.resource + ' not found: ' + id);
    saveResourceStore(state.workspace.root, state.resource, next);
    info('Deleted ' + state.resource + ': ' + id);
    return Promise.resolve();
  }

  function openRecordFromDashboard(tokens) {
    var id = tokens[1];
    if (!id) throw new Error('open <id>');
    if (state.session) {
      throw new Error(state.resource + ' open is not available through the remote API — use list instead.');
    }
    var record = findRecord(state.workspace.root, state.resource, id);
    if (!record) throw new Error(state.resource + ' not found: ' + id);
    console.log(stringifyRecord(record));
    return Promise.resolve();
  }

  function handleLine(line) {
    var tokens = tokenizeCommandLine(line);
    if (tokens.length === 0 || tokens[0] === 'refresh') {
      return refresh();
    }
    var cmd = tokens[0].toLowerCase();
    if (cmd === 'exit' || cmd === 'quit' || cmd === 'q') {
      stopDashboard();
      return Promise.resolve();
    }
    if (cmd === 'help') {
      console.log('Dashboard commands:');
      console.log('  resource <name>       switch active resource');
      console.log('  create [--field val]  create record in current resource');
      console.log('  update <id> [--f v]   patch record');
      console.log('  delete <id>           delete record');
      console.log('  open <id>             show full json');
      console.log('  status <v|clear>      set/clear status filter');
      console.log('  search <t|clear>      set/clear search filter');
      console.log('  page <n> | next | prev');
      console.log('  watch on|off          toggle live refresh');
      console.log('  interval <sec>        set refresh interval');
      console.log('  refresh               force refresh');
      console.log('  quit                  exit dashboard');
      return Promise.resolve().then(function () { return refresh(); });
    }
    if (cmd === 'resource') {
      var nextResource = tokens[1];
      if (!nextResource || !RESOURCE_DEFS[nextResource]) throw new Error('Unknown resource: ' + (nextResource || ''));
      state.resource = nextResource;
      state.page = 1;
      return refresh();
    }
    if (cmd === 'page') {
      var page = parseInt(tokens[1] || '1', 10);
      if (isNaN(page) || page < 1) throw new Error('page must be >= 1');
      state.page = page;
      return refresh();
    }
    if (cmd === 'next') {
      state.page += 1;
      return refresh();
    }
    if (cmd === 'prev') {
      state.page = Math.max(1, state.page - 1);
      return refresh();
    }
    if (cmd === 'status') {
      var status = tokens.slice(1).join(' ').trim();
      state.status = (!status || status === 'clear') ? '' : status;
      state.page = 1;
      return refresh();
    }
    if (cmd === 'search') {
      var term = tokens.slice(1).join(' ').trim();
      state.search = (!term || term === 'clear') ? '' : term;
      state.page = 1;
      return refresh();
    }
    if (cmd === 'watch') {
      var mode = String(tokens[1] || '').toLowerCase();
      if (mode !== 'on' && mode !== 'off') throw new Error('watch on|off');
      setWatch(mode === 'on');
      return refresh();
    }
    if (cmd === 'interval') {
      var seconds = parseInt(tokens[1] || '', 10);
      if (isNaN(seconds) || seconds < 1) throw new Error('interval <seconds>');
      state.intervalSeconds = seconds;
      setWatch(state.watch);
      return refresh();
    }
    if (cmd === 'create') {
      return createRecordFromDashboard(tokens).then(function () { return refresh(); });
    }
    if (cmd === 'update') {
      return updateRecordFromDashboard(tokens).then(function () { return refresh(); });
    }
    if (cmd === 'delete') {
      return deleteRecordFromDashboard(tokens).then(function () { return refresh(); });
    }
    if (cmd === 'open' || cmd === 'get') {
      return openRecordFromDashboard(tokens).then(function () {
        return askInline('Press Enter to continue', '').then(function () { return refresh(); });
      });
    }
    throw new Error('Unknown dashboard command: ' + cmd);
  }

  rl.on('line', function (line) {
    Promise.resolve()
      .then(function () { return handleLine(line); })
      .catch(function (err) { error(err.message); });
  });
  rl.on('SIGINT', function () { stopDashboard(); });
  rl.on('close', function () {
    if (timer) clearInterval(timer);
    console.log('');
    info('Dashboard closed.');
  });

  setWatch(state.watch);
  return refresh();
}

function handleResource(resource, argv) {
  var sub = argv[0];
  if (!sub) sub = defaultVerbFor(resource);
  if (sub === 'help') {
    printSection(resource, verbsFor(resource));
    return;
  }

  var remoteResult = maybeHandleRemoteResource(resource, sub, argv.slice(1));
  if (remoteResult !== null) return remoteResult;

  if (sub === 'create' || sub === 'add' || sub === 'upload' || sub === 'submit') return resourceCreate(resource, argv.slice(1));
  if (sub === 'get') return resourceGet(resource, argv.slice(1));
  if (sub === 'list') return resourceList(resource, argv.slice(1));
  if (sub === 'update') return resourceUpdate(resource, argv.slice(1));
  if (sub === 'delete' || sub === 'remove') return resourceDelete(resource, argv.slice(1));
  if (sub === 'approve' || sub === 'reject' || sub === 'archive' || sub === 'cancel' || sub === 'start' || sub === 'complete' || sub === 'verify') return resourceStatus(resource, sub, argv.slice(1));
  if (sub === 'assign') return resourceAssign(resource, argv.slice(1));
  if (sub === 'watch' || sub === 'tail' || sub === 'history') return resourceWatch(resource, argv.slice(1));
  if (sub === 'export') return resourceExport(resource, argv.slice(1));
  if (sub === 'import') return resourceImport(resource, argv.slice(1));
  if (sub === 'download') return resourceDownload(resource, argv.slice(1));
  if (sub === 'search') return resourceSearch(resource, argv.slice(1));
  if (sub === 'timeline') return resourceTimeline(resource, argv.slice(1));
  if (sub === 'graph') return resourceGraph(resource, argv.slice(1));

  error('Unknown ' + resource + ' command: ' + sub);
  printSection(resource, verbsFor(resource));
  process.exitCode = 1;
}

function verbsFor(resource) {
  if (resource === 'mission') return ['create', 'get', 'list', 'update', 'delete', 'archive', 'cancel', 'export', 'import', 'watch', 'timeline', 'graph'];
  if (resource === 'activity') return ['create', 'list', 'get', 'update', 'delete', 'assign', 'start', 'complete', 'verify', 'watch'];
  if (resource === 'participant') return ['create', 'list', 'get', 'update', 'delete', 'assign'];
  if (resource === 'capability') return ['list', 'search', 'create', 'update'];
  if (resource === 'knowledge') return ['add', 'upload', 'list', 'remove'];
  if (resource === 'objective' || resource === 'constraint' || resource === 'policy') return ['create', 'list', 'delete', 'update'];
  if (resource === 'deliverable') return ['submit', 'list', 'download', 'approve', 'reject'];
  if (resource === 'evidence') return ['upload', 'list', 'verify'];
  if (resource === 'verification') return ['run', 'approve', 'reject', 'history'];
  if (resource === 'settlement') return ['create', 'approve', 'export'];
  if (resource === 'event') return ['list', 'watch', 'tail'];
  return ['create', 'get', 'list', 'update', 'delete'];
}

function defaultVerbFor(resource) {
  if (resource === 'knowledge') return 'list';
  if (resource === 'capability') return 'list';
  if (resource === 'event') return 'list';
  if (resource === 'verification') return 'history';
  return 'list';
}

function authLogin(argv) {
  var args = parseArgs(argv);
  var interactive = args.interactive || (argv.length === 0 && process.stdin.isTTY);
  var session = {
    name: args.name || 'default',
    url: args.url || 'https://api.getpoiva.com',
    token: args.token || '',
    createdAt: new Date().toISOString(),
    updatedAt: new Date().toISOString()
  };

  if (interactive) {
    var prompt = createPrompt();
    return prompt.ask('Poiva Server', session.url).then(function (url) {
      session.url = url || session.url;
      return prompt.ask('Session name', session.name);
    }).then(function (name) {
